NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only
GOOGLE_GENERATIVE_AI_API_KEY=        # server only (when AI_PROVIDER=google)
OPENROUTER_API_KEY=                  # server only (when AI_PROVIDER=openrouter)
OPENROUTER_BASE_URL=                 # optional proxy, e.g. https://x.workers.dev/api/v1

AI_PROVIDER=openrouter               # openrouter | google
AI_MODEL_CHAT=                       # strong model id (check current name in provider docs)
AI_MODEL_FAST=                       # fast/cheap model id (summaries, classification, memory)
AI_MODEL_JUDGE=                      # optional: model that checks summary claims against the notes (the biggest
                                     # token user); unset = AI_MODEL_CHAT. A cheap model here saves the most.
AI_MODEL_EMBEDDING=                  # embedding model id
AI_EMBEDDING_DIM=768
AI_STRUCTURED_OUTPUT=native           # native (SDK forces the JSON schema; Gemini) | text (model returns plain JSON that is validated here; needed for models without schema mode, e.g. minimax)

LOCAL_AUTO_LOGIN=false               # dev only: skip the login screen (ignored in production)
LOCAL_AUTO_LOGIN_EMAIL=
LOCAL_AUTO_LOGIN_PASSWORD=

ALLOWED_EMAILS=ornek@mail.com        # comma separated; only these can sign up
DAILY_TOKEN_BUDGET=600000            # daily safety limit in tokens; /settings shows the real usage per purpose
